---
interface Props {
  href: string;
  filename: string;
}

const { href, filename } = Astro.props;
---

<a
  id="resume-btn"
  class="w-fit text-slate-200 flex flex-row gap-x-2 items-center group mt-12 px-5 py-2.5 rounded-xl bg-slate-400/10 border border-slate-400/20 hover:bg-green-400/10 hover:border-green-400/30 transition-all duration-300"
  href={href}
  download
>
  <div
    class="relative group-hover:text-green-400 transition-colors duration-300 after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-green-400 after:transition-all after:duration-300 group-hover:after:w-full"
  >
    Download My Resume
  </div>

  <svg
    class="group-hover:translate-x-2 transition-all group-hover:text-green-400"
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="24"
    viewBox="0 0 16 9"
    ><path
      fill="currentColor"
      d="M12.5 5h-9c-.28 0-.5-.22-.5-.5s.22-.5.5-.5h9c.28 0 .5.22.5.5s-.22.5-.5.5Z"
    ></path><path
      fill="currentColor"
      d="M10 8.5a.47.47 0 0 1-.35-.15c-.2-.2-.2-.51 0-.71l3.15-3.15l-3.15-3.15c-.2-.2-.2-.51 0-.71c.2-.2.51-.2.71 0l3.5 3.5c.2.2.2.51 0 .71l-3.5 3.5c-.1.1-.23.15-.35.15Z"
    ></path></svg
  >
</a>

<div id="resume-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/80 backdrop-blur-sm p-4 lg:p-8">
  <div class="relative w-full max-w-4xl h-full max-h-[90vh] bg-slate-800/90 border border-slate-700/50 rounded-2xl flex flex-col overflow-hidden shadow-2xl">
    <div class="flex items-center justify-between px-5 py-4 border-b border-slate-700/50 shrink-0">
      <p class="text-slate-200 font-medium text-sm">Resume Preview</p>
      <div class="flex items-center gap-x-3">
        <a
          href={href}
          download={filename}
          class="text-xs text-slate-200 px-3 py-1.5 rounded-lg bg-slate-400/10 border border-slate-400/20 hover:bg-green-400/10 hover:border-green-400/30 transition-all duration-300"
        >
          Download
        </a>
        <button
          id="close-modal"
          class="text-slate-400 hover:text-slate-200 transition-colors duration-300 p-1"
          aria-label="Close preview"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
    <iframe
      id="resume-iframe"
      src=""
      class="flex-1 w-full"
      title="Resume Preview"
    ></iframe>
  </div>
</div>

<script define:vars={{ href }}>
  const resumeBtn = document.getElementById("resume-btn");
  const resumeModal = document.getElementById("resume-modal");
  const closeModalBtn = document.getElementById("close-modal");
  const resumeIframe = document.getElementById("resume-iframe");

  const openModal = () => {
    if (resumeIframe && !resumeIframe.src.includes(".pdf")) {
      resumeIframe.src = href;
    }
    resumeModal?.classList.remove("hidden");
    resumeModal?.classList.add("flex");
    document.body.style.overflow = "hidden";
  };

  const closeModal = () => {
    resumeModal?.classList.add("hidden");
    resumeModal?.classList.remove("flex");
    document.body.style.overflow = "";
  };

  resumeBtn?.addEventListener("click", (e) => {
    if (window.innerWidth >= 1024) {
      e.preventDefault();
      openModal();
    }
  });

  closeModalBtn?.addEventListener("click", closeModal);

  resumeModal?.addEventListener("click", (e) => {
    if (e.target === resumeModal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>
