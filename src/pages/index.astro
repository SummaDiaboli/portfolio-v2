---
import Layout from "@layouts/Layout.astro";

import Card from "@components/Card.astro";
import ContactButton from "@components/ContactButton.astro";
import ProfileBriefLink from "@components/ProfileBriefLink.astro";
import ResumeModal from "@components/ResumeModal.astro";
import SectionHeader from "@components/SectionHeader.astro";
import SocialLinks from "@components/SocialLinks.astro";
import StyledLink from "@components/StyledLink.astro";
import { profileData } from "@utils/profileData";

const { education, interests, personalDetails, resume, skills } = profileData;
---

<Layout title="Salim Hussaini | Fullstack Software Engineer">
  <main
    class="h-screen lg:grid lg:grid-cols-2 lg:gap-x-16 mx-5 py-10 lg:py-0 lg:px-16 xl:px-32 2xl:px-56"
  >
    <div>
      <div class="flex flex-col lg:justify-around lg:h-screen sticky top-0">
        <div>
          <div class="mb-10 lg:mb-20">
            <h1
              id="intro-name"
              class="text-5xl tracking-tight lg:text-6xl font-bold mb-4 bg-clip-text text-transparent"
              style="background-image: linear-gradient(90deg, #e2e8f0, #86efac, #e2e8f0); background-size: 200%; animation: gradient-shift 6s ease infinite;"
            >
              Salim Hussaini
            </h1>
            <h2
              id="intro-role"
              class="tracking-tight text-xl lg:text-3xl font-semibold mb-6 text-slate-200"
            >
              Fullstack Software Engineer
            </h2>

            <p id="intro-brief" class="max-w-sm text-slate-300 leading-relaxed">
              {personalDetails.brief}
            </p>
          </div>

          <div class="hidden lg:block border-t border-slate-700/50 mb-6"></div>

          <div id="intro-nav" class="hidden lg:flex">
            <nav class="uppercase flex flex-col gap-y-2">
              <a
                href="#about"
                class="flex flex-row items-center gap-x-3 navlink w-fit px-4 py-2 group transition duration-500"
              >
                <div
                  class="bg-slate-600 group-hover:bg-green-400 h-0.5 w-7 group-hover:w-14 transition-all duration-500"
                >
                </div>
                <p
                  class="text-xs leading-tight tracking-widest font-bold text-slate-400 group-hover:text-green-400"
                >
                  About
                </p>
              </a>

              <a
                href="#experience"
                class="flex flex-row items-center gap-x-3 navlink w-fit px-4 py-2 group transition duration-500"
              >
                <div
                  class="bg-slate-600 group-hover:bg-green-400 h-0.5 w-7 group-hover:w-14 transition-all duration-500"
                >
                </div>
                <p
                  class="text-xs leading-tight tracking-widest font-bold text-slate-400 group-hover:text-green-400"
                >
                  Experience
                </p>
              </a>

              <a
                href="#contact"
                class="flex flex-row items-center gap-x-3 navlink w-fit px-4 py-2 group transition duration-500"
              >
                <div
                  class="bg-slate-600 group-hover:bg-green-400 h-0.5 w-7 group-hover:w-14 transition-all duration-500"
                >
                </div>
                <p
                  class="text-xs leading-tight tracking-widest font-bold text-slate-400 group-hover:text-green-400"
                >
                  Contact
                </p>
              </a>
            </nav>
          </div>
        </div>

        <div id="intro-social">
          <SocialLinks githubLink={personalDetails.githubLink} linkedInLink={personalDetails.linkedInLink} />
        </div>
      </div>
    </div>

    <div class="py-24 flex flex-col space-y-20 lg:space-y-32">
      <section
        id="about"
        class="flex flex-col space-y-4 lg:space-y-5 scroll-mt-28"
      >
        <SectionHeader title="About" />

        <p class="about-paragraph text-slate-300">
          Over the last six years, I have engineered software for everything from <ProfileBriefLink
            text={"international e-commerce platforms"}
            url={"https://nextbasket.com/"}
          /> to <ProfileBriefLink
            text={"national tech agencies,"}
            url={"https://ncair.nitda.gov.ng/"}
          /> working across <ProfileBriefLink text={"React,"} url={"https://react.dev/"} /> <ProfileBriefLink text="Next.js," url="https://nextjs.org/" /> <ProfileBriefLink text="Node.js," url="https://nodejs.org/en" /> and <ProfileBriefLink text="PostgreSQL" url="https://postgresql.org/" /> to ship everything from ML-powered diagnostic tools to full-scale e-commerce platforms. Today, I combine that engineering depth with cybersecurity research in Zero Trust microservice architecture to build systems that are as secure as they are scalable.
        </p>
        <p class="about-paragraph text-slate-300">
          Most recently, as a
          <strong
            >Senior Frontend Developer at
            <ProfileBriefLink
              url="https://nextbasket.com/"
              text="NEXT BASKET,"
            />
          </strong> I led performance work on high-volume order pages handling 10,000+ records, architected a shared AI chatbot package across two platforms, and established frontend testing standards across the Next.js codebase. I am always exploring the edges of modern web tech, which is why I chose to build this portfolio using
          <ProfileBriefLink url="https://astro.build/" text="Astro." />
        </p>
      </section>

      <section id="experience" class="scroll-mt-28">
        <SectionHeader title="Experience" />

        <ul class="flex flex-col gap-y-5 lg:gap-y-10 group/cards -m-5 pointer-events-none">
          {
            profileData.resume.map((data) => (
              <li class="experience-card cursor-pointer px-5 pointer-events-auto">
                {data.link ? (
                  <a
                    href={data.link}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <Card {...data} />
                  </a>
                ) : (
                  <div>
                    <Card {...data} />
                  </div>
                )}
              </li>
            ))
          }
        </ul>

        <ResumeModal href="/Resume - Salim Hussaini.pdf" filename="Resume - Salim Hussaini.pdf" />
      </section>

      <section id="contact" class="scroll-mt-28">
        <SectionHeader title="Contact" />

        <div class="rounded-xl bg-slate-400/5 border border-slate-400/10 p-6 flex flex-col space-y-5">
          <p class="contact-text text-slate-300 leading-relaxed">
            I am currently open to new opportunities. Whether you have a role in mind, a project to discuss, or just want to say hello, feel free to reach out.
          </p>

          <div class="flex flex-col sm:flex-row gap-3">
            <ContactButton
              href={`mailto:${personalDetails.email}`}
              label="Send an email"
              copyValue={personalDetails.email}
              toastMessage="Email address copied"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="22,6 12,13 2,6"/>
              </svg>
            </ContactButton>

            <ContactButton
              href={`tel:${personalDetails.phone.replace(/\s/g, "")}`}
              label={personalDetails.phone}
              copyValue={personalDetails.phone}
              toastMessage="Phone number copied"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M22 16.92v3a2 2 0 0 1-2.18 2a19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </ContactButton>
          </div>
        </div>
      </section>

      <footer class="max-w-md pb-16 text-sm text-slate-400 sm:pb-0">
        <p class="mt-4">
          Built with
          <StyledLink url="https://astro.build/" rel="noopener noreferrer" class="font-medium">Astro</StyledLink>
          &
          <StyledLink url="https://tailwindcss.com/" rel="noopener noreferrer" class="font-medium">Tailwind CSS</StyledLink>, deployed on
          <StyledLink url="https://cloudflare.com/" rel="noopener noreferrer" class="font-medium">Cloudflare</StyledLink>. All text is set in the
          <StyledLink url="https://fonts.google.com/specimen/Inter" rel="noopener noreferrer" class="font-medium">Inter</StyledLink>
          typeface.
        </p>
      </footer>
    </div>
  </main>

  <div
    id="toast"
    class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-200 text-sm flex items-center gap-x-2 shadow-lg opacity-0 pointer-events-none"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-green-400">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
    <span id="toast-message"></span>
  </div>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollToPlugin } from "gsap/ScrollToPlugin";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollToPlugin, ScrollTrigger);

  gsap.fromTo(
    ["#intro-name", "#intro-role", "#intro-brief", "#intro-nav", "#intro-social"],
    { opacity: 0, y: 20 },
    { opacity: 1, y: 0, duration: 0.6, stagger: 0.15, ease: "power2.out" }
  );

  const aboutDiv = `.navlink[href="#about"] > div`;
  const aboutP = `.navlink[href="#about"] > p`;
  const expDiv = `.navlink[href="#experience"] > div`;
  const expP = `.navlink[href="#experience"] > p`;
  const contactDiv = `.navlink[href="#contact"] > div`;
  const contactP = `.navlink[href="#contact"] > p`;

  document.addEventListener("DOMContentLoaded", () => {
    if (window.location.href.includes("#")) {
      let anchor = `#${window.location.href.split("#")[1]}`;

      gsap.fromTo(
        window,
        { scrollTo: { y: 0 } },
        { duration: 0.5, scrollTo: { y: anchor, offsetY: 50 } }
      );

      if (aboutDiv.includes(anchor)) {
        gsap.to(aboutDiv, {
          onStart: () => {
            document.querySelector(aboutDiv)?.classList.replace("w-7", "w-14");
            document.querySelector(aboutDiv)?.classList.replace("bg-slate-600", "bg-green-400");
            document
              .querySelector(aboutP)
              ?.classList.replace("text-slate-400", "text-green-400");
          },
        });
      }
    } else {
      gsap.to(aboutDiv, {
        onStart: () => {
          document.querySelector(aboutDiv)?.classList.replace("w-7", "w-14");
          document.querySelector(aboutDiv)?.classList.replace("bg-slate-600", "bg-green-400");
          document
            .querySelector(aboutP)
            ?.classList.replace("text-slate-400", "text-green-400");
        },
      });
    }
  });

  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".navlink");
  navLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      // e.preventDefault();
      let anchor = `#${link.href.split("#")[1]}`;
      history.pushState(null, "", anchor);
      gsap.to(window, {
        duration: 0.1,
        scrollTo: { y: anchor, offsetY: 50 },
      });
    });
  });

  gsap.utils.toArray<HTMLElement>(".about-paragraph").forEach((el) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 20 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power2.out",
        scrollTrigger: {
          trigger: el,
          start: "top 85%",
        },
      }
    );
  });

  gsap.utils.toArray<HTMLElement>(".experience-card").forEach((el, i) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 24 },
      {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "power2.out",
        delay: i * 0.05,
        scrollTrigger: {
          trigger: el,
          start: "top 90%",
        },
      }
    );
  });

  gsap.utils.toArray<HTMLElement>(".section-label").forEach((el) => {
    gsap.fromTo(
      el,
      { opacity: 0, x: -10 },
      {
        opacity: 1,
        x: 0,
        duration: 0.4,
        ease: "power2.out",
        scrollTrigger: {
          trigger: el,
          start: "top 90%",
        },
      }
    );
  });

  gsap.utils.toArray<HTMLElement>(".contact-text").forEach((el) => {
    gsap.fromTo(
      el,
      { opacity: 0, y: 20 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power2.out",
        scrollTrigger: {
          trigger: el,
          start: "top 85%",
        },
      }
    );
  });

  ScrollTrigger.create({
    trigger: "#contact",
    start: "top center",
    onEnter: () => {
      gsap.to(expDiv, {
        onStart: () => {
          document.querySelector(expDiv)?.classList.replace("w-14", "w-7");
          document.querySelector(expDiv)?.classList.replace("bg-green-400", "bg-slate-600");
          document.querySelector(expP)?.classList.replace("text-green-400", "text-slate-400");
        },
      });
      gsap.to(contactDiv, {
        onStart: () => {
          document.querySelector(contactDiv)?.classList.replace("w-7", "w-14");
          document.querySelector(contactDiv)?.classList.replace("bg-slate-600", "bg-green-400");
          document.querySelector(contactP)?.classList.replace("text-slate-400", "text-green-400");
        },
      });
    },
    onLeaveBack: () => {
      gsap.to(contactDiv, {
        onStart: () => {
          document.querySelector(contactDiv)?.classList.replace("w-14", "w-7");
          document.querySelector(contactDiv)?.classList.replace("bg-green-400", "bg-slate-600");
          document.querySelector(contactP)?.classList.replace("text-green-400", "text-slate-400");
        },
      });
      gsap.to(expDiv, {
        onStart: () => {
          document.querySelector(expDiv)?.classList.replace("w-7", "w-14");
          document.querySelector(expDiv)?.classList.replace("bg-slate-600", "bg-green-400");
          document.querySelector(expP)?.classList.replace("text-slate-400", "text-green-400");
        },
      });
    },
  });

  ScrollTrigger.create({
    trigger: "#about",
    start: "bottom center",
    onLeave: () => {
      // gsap.fromTo(`.navlink[href="#about"]`, { opacity: 1 }, { opacity: 0.5 });
      gsap.to(aboutDiv, {
        // duration: 0.5,
        onStart: () => {
          document.querySelector(aboutDiv)?.classList.replace("w-14", "w-7");
          document.querySelector(aboutDiv)?.classList.replace("bg-green-400", "bg-slate-600");
          document
            .querySelector(aboutP)
            ?.classList.replace("text-green-400", "text-slate-400");
        },
      });
      gsap.to(expDiv, {
        onStart: () => {
          document.querySelector(expDiv)?.classList.replace("w-7", "w-14");
          document.querySelector(expDiv)?.classList.replace("bg-slate-600", "bg-green-400");
          document
            .querySelector(expP)
            ?.classList.replace("text-slate-400", "text-green-400");
        },
      });
    },
    onEnterBack: () => {
      gsap.to(expDiv, {
        onStart: () => {
          document.querySelector(expDiv)?.classList.replace("w-14", "w-7");
          document.querySelector(expDiv)?.classList.replace("bg-green-400", "bg-slate-600");
          document
            .querySelector(expP)
            ?.classList.replace("text-green-400", "text-slate-400");
        },
      });

      gsap.to(aboutDiv, {
        onStart: () => {
          document.querySelector(aboutDiv)?.classList.replace("w-7", "w-14");
          document.querySelector(aboutDiv)?.classList.replace("bg-slate-600", "bg-green-400");
          document
            .querySelector(aboutP)
            ?.classList.replace("text-slate-400", "text-green-400");
        },
      });
    },
  });

  const toast = document.getElementById("toast");
  const toastMessage = document.getElementById("toast-message");
  let toastTimeout: ReturnType<typeof setTimeout>;

  const showToast = (message: string) => {
    if (!toast || !toastMessage) return;
    toastMessage.textContent = message;
    clearTimeout(toastTimeout);
    gsap.killTweensOf(toast);
    gsap.fromTo(toast, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.25, ease: "power2.out" });
    toastTimeout = setTimeout(() => {
      gsap.to(toast, { opacity: 0, y: 10, duration: 0.25, ease: "power2.in" });
    }, 2000);
  };

  document.addEventListener("copy-toast", (e) => {
    showToast((e as CustomEvent<string>).detail);
  });

</script>
