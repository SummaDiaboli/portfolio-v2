---
import Layout from "@layouts/Layout.astro";

import Card from "@components/Card.astro";
import ProfileBriefLink from "@components/ProfileBriefLink.astro";
import { profileData } from "@utils/profileData";
import { Icon } from "astro-icon/components";

const { education, interests, personalDetails, resume, skills } = profileData;
---

<Layout title="Salim Hussaini | Fullstack Software Engineer">
  <main
    class="h-screen lg:grid lg:grid-cols-2 lg:justify-items-center lg:px-56 mx-5 py-10 lg:py-0"
  >
    <div>
      <div class="flex flex-col lg:justify-around lg:h-screen sticky top-0">
        <div>
          <div class="mb-10 lg:mb-20">
            <h1
              class="text-5xl tracking-tight lg:text-6xl font-bold mb-4 text-slate-200"
            >
              Salim Hussaini
            </h1>
            <p
              class="tracking-tight lg:text-3xl font-semibold mb-6 text-slate-200"
            >
              Fullstack Software Engineer
            </p>

            <p class="w-[75%]">
              {personalDetails.brief}
            </p>
          </div>

          <div class="hidden lg:flex">
            <nav class="uppercase flex flex-col gap-y-2">
              <a
                href="#about"
                class="flex flex-row items-center gap-x-3 navlink w-fit group transition duration-500"
              >
                <div
                  class="bg-white h-0.5 w-7 group-hover:w-14 transition-all duration-500"
                >
                </div>
                <p
                  class="text-xs leading-tight tracking-widest font-bold text-slate-400 group-hover:text-slate-200"
                >
                  About
                </p>
              </a>

              <a
                href="#experience"
                class="flex flex-row items-center gap-x-3 navlink w-fit group transition duration-500"
              >
                <div
                  class="bg-white h-0.5 w-7 group-hover:w-14 transition-all duration-500"
                >
                </div>
                <p
                  class="text-xs leading-tight tracking-widest font-bold text-slate-400 group-hover:text-slate-200 data-active"
                >
                  Experience
                </p>
              </a>
            </nav>
          </div>
        </div>

        <div>
          <ul class="flex flex-row space-x-4">
            <li>
              <a
                href={personalDetails.githubLink}
                target="_blank"
                rel="no-referrer"
              >
                <Icon
                  name="fontisto:github"
                  class="text-2xl text-slate-400 hover:text-slate-200 cursor-pointer"
                />
                <p class="sr-only">GitHub</p>
              </a>
            </li>

            <li>
              <a
                href={personalDetails.linkedInLink}
                target="_blank"
                rel="no-referrer"
              >
                <Icon
                  name="fontisto:linkedin"
                  class="text-2xl text-slate-400 hover:text-slate-200 cursor-pointer"
                />
                <p class="sr-only">LinkedIn</p>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="py-24 flex flex-col space-y-20 lg:space-y-32">
      <section
        id="about"
        class="lg:flex lg:flex-col lg:space-y-5 scroll-mt-28 text-justify"
      >
        <div
          class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-slate-900 75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0"
        >
          <h2
            class="text-sm font-bold uppercase tracking-widest text-slate-200 lg:sr-only"
          >
            About
          </h2>
        </div>

        <!-- <p>
          From tinkering with my dad's desktop PC as a kid to building software
          for <ProfileBriefLink url="https://yiaga.org/" text="NGOs" />,
          <ProfileBriefLink url="https://314ltd.com/" text="home automation" />,
          a <ProfileBriefLink
            text={"national organization"}
            url={"https://ncair.nitda.gov.ng/"}
          />, and <ProfileBriefLink
            text={"high-profile startups"}
            ,
            url={"https://nextbasket.com/"}
          />, I've had a blast exploring the digital world. My journey has been
          fueled by a lifelong curiosity and a passion for creating innovative
          solutions.
        </p>
        <p>
          Currently, I'm a Senior Frontend Developer at <ProfileBriefLink
            url="https://nextbasket.com/"
            text="NEXT BASKET"
          />, crafting top-notch e-commerce solutions. When I'm not immersed in
          work, I explore new tech trends and build side projects. This
          portfolio, for instance, was built using
          <ProfileBriefLink url="https://astro.build/" text="Astro" />.
        </p> -->

        <p>
          From tinkering with my dad's desktop PC as a kid to building software
          for <ProfileBriefLink url="https://yiaga.org/" text="NGOs," />
          <ProfileBriefLink url="https://314ltd.com/" text="home automation," />
          a <ProfileBriefLink
            text={"national organization,"}
            url={"https://ncair.nitda.gov.ng/"}
          /> and <ProfileBriefLink
            text={"high-profile startups,"}
            url={"https://nextbasket.com/"}
          /> I've had a blast exploring the digital world. My journey has been fueled
          by a lifelong curiosity and a passion for creating innovative solutions.
        </p>
        <p>
          My expertise lies in building
          <strong>scalable, user-centric web applications</strong>
          using a modern stack, including
          <ProfileBriefLink text={"React,"} url={"https://react.dev/"} />
          <ProfileBriefLink text="Next.js," url="https://nextjs.org/" /> and
          <ProfileBriefLink text="Node.js." url="https://nodejs.org/en" /> My professional
          journey has allowed me to lead ML and Python workshops, build robust backend
          APIs with Node.js and
          <ProfileBriefLink text="Express," url="https://expressjs.com/" /> design
          <ProfileBriefLink
            text="PostgreSQL"
            url="https://www.postgresql.org/"
          />
          databases, and develop mobile applications with
          <ProfileBriefLink text="Flutter" url="https://flutter.dev/" /> and
          <ProfileBriefLink
            text="React Native."
            url="https://reactnative.dev/"
          />
        </p>
        <p>
          Most recently, as a
          <strong
            >Senior Frontend Developer at
            <ProfileBriefLink
              url="https://nextbasket.com/"
              text="NEXT BASKET,"
            />
          </strong> I collaborated with cross-functional, international teams to
          deliver high-quality frontend solutions. My focus was on leveraging Next.js
          to develop scalable, user-friendly e-commerce interfaces and resolving
          complex performance bottlenecks to significantly improve website speed
          and user experience. When I'm not immersed in work, I explore new tech
          trends. This portfolio, for instance, was built using
          <ProfileBriefLink url="https://astro.build/" text="Astro." />
        </p>
      </section>

      <section id="experience" class="scroll-mt-28">
        <div
          class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-slate-900 75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0"
        >
          <h2
            class="text-sm font-bold uppercase tracking-widest text-slate-200 lg:sr-only"
          >
            Experience
          </h2>
        </div>

        <ul class="flex flex-col gap-y-5 lg:gap-y-10 group/cards -m-5">
          {profileData.resume.map((data) => <Card {...data} />)}
        </ul>

        <a
          class="text-slate-200 flex flex-row gap-x-1 items-center group mt-6"
          href="/Resume - Salim Hussaini.pdf"
          download
        >
          <div
            class="group-hover:underline group-hover:decoration-green-400 group-hover:underline-offset-4"
          >
            View Full Resume
          </div>

          <svg
            class="group-hover:translate-x-2 transition-all"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="24"
            viewBox="0 0 16 9"
            ><path
              fill="currentColor"
              d="M12.5 5h-9c-.28 0-.5-.22-.5-.5s.22-.5.5-.5h9c.28 0 .5.22.5.5s-.22.5-.5.5Z"
            ></path><path
              fill="currentColor"
              d="M10 8.5a.47.47 0 0 1-.35-.15c-.2-.2-.2-.51 0-.71l3.15-3.15l-3.15-3.15c-.2-.2-.2-.51 0-.71c.2-.2.51-.2.71 0l3.5 3.5c.2.2.2.51 0 .71l-3.5 3.5c-.1.1-.23.15-.35.15Z"
            ></path></svg
          >
        </a>
      </section>

      <footer class="max-w-md pb-16 text-sm text-slate-500 sm:pb-0">
        <p class="mt-4">
          Built with
          <a
            href="https://astro.build/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-slate-400 hover:text-slate-300">Astro</a
          >
          &
          <a
            href="https://tailwindcss.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-slate-400 hover:text-slate-300"
            >Tailwind CSS</a
          >, deployed on
          <a
            href="https://cloudflare.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-slate-400 hover:text-slate-300"
            >Cloudflare</a
          >. All text is set in the
          <a
            href="https://fonts.google.com/specimen/Inter"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-slate-400 hover:text-slate-300">Inter</a
          >
          typeface.
        </p>
      </footer>
    </div>
  </main>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollToPlugin } from "gsap/ScrollToPlugin";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollToPlugin, ScrollTrigger);

  const aboutDiv = `.navlink[href="#about"] > div`;
  const aboutP = `.navlink[href="#about"] > p`;
  const expDiv = `.navlink[href="#experience"] > div`;
  const expP = `.navlink[href="#experience"] > p`;

  document.addEventListener("DOMContentLoaded", () => {
    if (window.location.href.includes("#")) {
      let anchor = `#${window.location.href.split("#")[1]}`;

      gsap.fromTo(
        window,
        { scrollTo: { y: 0 } },
        { duration: 0.5, scrollTo: { y: anchor, offsetY: 50 } }
      );

      if (aboutDiv.includes(anchor)) {
        gsap.to(aboutDiv, {
          onStart: () => {
            document.querySelector(aboutDiv).classList.replace("w-7", "w-14");
            document
              .querySelector(aboutP)
              .classList.replace("text-slate-400", "text-slate-200");
          },
        });
      }
    } else {
      gsap.to(aboutDiv, {
        onStart: () => {
          document.querySelector(aboutDiv).classList.replace("w-7", "w-14");
          document
            .querySelector(aboutP)
            .classList.replace("text-slate-400", "text-slate-200");
        },
      });
    }
  });

  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".navlink");
  navLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      // e.preventDefault();
      let anchor = `#${link.href.split("#")[1]}`;
      history.pushState(null, "", anchor);
      gsap.to(window, {
        duration: 0.1,
        scrollTo: { y: anchor, offsetY: 50 },
      });
    });
  });

  ScrollTrigger.create({
    trigger: "#about",
    start: "bottom center",
    onLeave: () => {
      // gsap.fromTo(`.navlink[href="#about"]`, { opacity: 1 }, { opacity: 0.5 });
      gsap.to(aboutDiv, {
        // duration: 0.5,
        onStart: () => {
          document.querySelector(aboutDiv).classList.replace("w-14", "w-7");
          document
            .querySelector(aboutP)
            .classList.replace("text-slate-200", "text-slate-400");
        },
      });
      gsap.to(expDiv, {
        onStart: () => {
          document.querySelector(expDiv).classList.replace("w-7", "w-14");

          document
            .querySelector(expP)
            .classList.replace("text-slate-400", "text-slate-200");
        },
      });
    },
    onEnterBack: () => {
      gsap.to(expDiv, {
        onStart: () => {
          document.querySelector(expDiv).classList.replace("w-14", "w-7");
          document
            .querySelector(expP)
            .classList.replace("text-slate-200", "text-slate-400");
        },
      });

      gsap.to(aboutDiv, {
        onStart: () => {
          document.querySelector(aboutDiv).classList.replace("w-7", "w-14");
          document
            .querySelector(aboutP)
            .classList.replace("text-slate-400", "text-slate-200");
        },
      });
    },
  });
</script>
