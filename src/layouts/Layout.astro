---
import "@styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Salim Hussaini is a Senior Fullstack Engineer specializing in high-performance web applications, with a track record of shipping production systems across e-commerce, civic tech, and AI/ML domains."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://salimhussaini.dev" />
    <meta property="og:title" content="Salim Hussaini | Fullstack Software Engineer" />
    <meta
      property="og:description"
      content="Salim Hussaini is a Senior Fullstack Engineer specializing in high-performance web applications, with a track record of shipping production systems across e-commerce, civic tech, and AI/ML domains."
    />
    <meta property="og:image" content="/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Salim Hussaini | Fullstack Software Engineer" />
    <meta
      name="twitter:description"
      content="Salim Hussaini is a Senior Fullstack Engineer specializing in high-performance web applications, with a track record of shipping production systems across e-commerce, civic tech, and AI/ML domains."
    />
    <meta name="twitter:image" content="/og.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
  </head>
  
  <body class="bg-portfolio text-slate-400 font-sans">
    <a
      href="#about"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded focus:bg-slate-800 focus:text-slate-200 focus:text-sm focus:font-medium focus:ring-2 focus:ring-green-400"
    >
      Skip to main content
    </a>
    <div id="spotlight" class="pointer-events-none fixed inset-0 z-30" style="transition: background 0.15s ease-out;"></div>
    <slot />
  </body>
</html>

<script>
  const spotlight = document.getElementById("spotlight");

  let currentX = 0;
  let currentY = 0;
  let targetX = 0;
  let targetY = 0;

  document.addEventListener("mousemove", (e) => {
    targetX = e.clientX;
    targetY = e.clientY;
  });

  function animateSpotlight() {
    currentX += (targetX - currentX) * 0.08;
    currentY += (targetY - currentY) * 0.08;

    if (spotlight) {
      spotlight.style.background = `radial-gradient(400px at ${currentX}px ${currentY}px, rgba(29, 78, 216, 0.15), transparent 80%)`;
    }

    requestAnimationFrame(animateSpotlight);
  }

  animateSpotlight();
</script>
